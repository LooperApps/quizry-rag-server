# ── Required ──────────────────────────────────────────────────────────────────

# Google AI (Gemini) API key — embeddings only. Required.
GEMINI_API_KEY=your-google-ai-api-key-here

# DeepSeek API key — query rewriting, reranking and vision (image OCR, scanned
# PDF pages, figure descriptions). Required: app/config.py declares it with no
# default, so the server will not start without it.
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Shared secret between this server and the Firebase Cloud Functions of the
# FIRST app listed in RAG_APPS (quiz_main by default).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEY=your-strong-random-secret-here

# ── Apps (tenants) ────────────────────────────────────────────────────────────
# One deployment serves several products, each with its own ChromaDB
# collection. Notebook IDs are only unique within a product, so a shared
# collection would let one app's notebook filter match the other's chunks.
#
# Format: comma-separated `id` or `id:collection` entries. The collection
# defaults to `<id>_docs`; the FIRST entry is the default app, the one admin
# routes address when no `?app=` is given.
#
# Leave both blank for single-tenant behaviour: one app, `notebook_docs`,
# authenticated with RAG_API_KEY — exactly what this server did before.
RAG_APPS=quiz_main:notebook_docs,daftar_ai:daftar_notebook_docs

# Per-app ingest/retrieve keys as `id:key` pairs. The first app in RAG_APPS
# falls back to RAG_API_KEY, so only the others need listing here. The key a
# caller presents IS the app selector — there is no way to name a different
# app in a request body, so a leaked key cannot reach another product's index.
# Every app must end up with a key or the server refuses to start.
RAG_APP_KEYS=daftar_ai:another-strong-random-secret

# ── Admin API ─────────────────────────────────────────────────────────────────
# Separate secret for the /admin routes, which the quizry-db-manager tool uses
# to browse chunks, trace queries and delete by notebook or source. Unlike the
# per-app keys above, the admin key reaches every app.
#
# Leave blank and RAG_API_KEY is accepted instead — convenient, but it means
# every Cloud Function's credential can also wipe the index. Set it in
# production. Generate the same way as RAG_API_KEY.
ADMIN_API_KEY=

# Set to false to remove the /admin routes entirely.
ENABLE_ADMIN=true

# ── Storage ───────────────────────────────────────────────────────────────────

# Local dev: relative path. Render: /data/chroma (persistent disk mount point).
# All apps' collections live under this one path — Chroma keeps them apart.
CHROMA_PATH=./data/chroma

# ── Models ────────────────────────────────────────────────────────────────────

# litellm model string for query rewriting + reranking
LITELLM_MODEL=deepseek/deepseek-chat

# Google AI embedding model. Changing this invalidates every stored vector —
# the old and new spaces are not comparable — so a change means re-ingesting
# every source in every app, not just a restart.
EMBEDDING_MODEL=gemini/gemini-embedding-001

# Vector size for NEW collections (768, 1536 or 3072). Existing collections
# keep the size they were built with; see POST /admin/reembed to move one.
EMBEDDING_DIMENSIONS=768

# ── Tuning ────────────────────────────────────────────────────────────────────

CHUNK_WORKERS=3
# Chunking mode: "default" (fast, no LLM) or "smart" (LLM-based semantic splitting)
CHUNK_MODE=default
RETRIEVAL_K=20
FINAL_K=10

# DeepSeek vision — all optional, these are the defaults.
# DEEPSEEK_API_BASE=https://api.deepseek.com
# VISION_MODEL=deepseek-flash
# VISION_MAX_TOKENS=3000
# VISION_MAX_PAGES=60
# VISION_CONCURRENCY=4
# VISION_TIMEOUT_S=120

# ── Dev ───────────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
# Set to true to enable /docs and /redoc (OpenAPI UI)
ENABLE_DOCS=true
