# ── Required ──────────────────────────────────────────────────────────────────

# Google AI (Gemini) API key for embeddings and LLM chunking/reranking
GEMINI_API_KEY=your-google-ai-api-key-here

# Shared secret between this server and the Firebase Cloud Functions.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEY=your-strong-random-secret-here

# ── Storage ───────────────────────────────────────────────────────────────────

# Local dev: relative path. Render: /data/chroma (persistent disk mount point).
CHROMA_PATH=./data/chroma

# ── Models ────────────────────────────────────────────────────────────────────

# litellm model string for chunking + reranking
LITELLM_MODEL=gemini/gemini-2.5-flash

# Google AI embedding model
EMBEDDING_MODEL=gemini/text-embedding-004

# ── Tuning ────────────────────────────────────────────────────────────────────

CHUNK_WORKERS=3
RETRIEVAL_K=20
FINAL_K=10

# ── Dev ───────────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
# Set to true to enable /docs and /redoc (OpenAPI UI)
ENABLE_DOCS=true
