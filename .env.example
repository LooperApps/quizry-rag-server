# ── Required ──────────────────────────────────────────────────────────────────

# OpenAI API key for embeddings (text-embedding-3-large) and LLM chunking/reranking
OPENAI_API_KEY=sk-proj-...

# Shared secret between this server and the Firebase Cloud Functions.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEY=your-strong-random-secret-here

# ── Storage ───────────────────────────────────────────────────────────────────

# Local dev: relative path. Render: /data/chroma (persistent disk mount point).
CHROMA_PATH=./data/chroma

# ── Models ────────────────────────────────────────────────────────────────────

# litellm model string for chunking + reranking (cheap, fast)
LITELLM_MODEL=openai/gpt-4.1-nano

# OpenAI embedding model
EMBEDDING_MODEL=text-embedding-3-large

# ── Tuning ────────────────────────────────────────────────────────────────────

CHUNK_WORKERS=3
RETRIEVAL_K=20
FINAL_K=10

# ── Dev ───────────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
# Set to true to enable /docs and /redoc (OpenAPI UI)
ENABLE_DOCS=true
